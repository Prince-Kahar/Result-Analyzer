{
  "name": "vnsgu-result-website",
  "version": "1.0.0",
  "private": true,
  "description": "VNSGU Academic Intelligence & Result Analysis Portal",
  "scripts": {
    "dev": "node run_dev.js",
    "start": "node backend/server.js",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build && node -e \"const fs=require('fs');fs.copyFileSync('frontend/dist/index.html','backend/public/index.html');console.log('Frontend synced to backend/public/index.html');\"",
    "build": "npm run build:frontend"
  },
  "keywords": [
    "vnsgu",
    "result-analysis",
    "react",
    "nodejs",
    "supabase"
  ],
  "author": "Prince Kahar",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^11.1.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}
